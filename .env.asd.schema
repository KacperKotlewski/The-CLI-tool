# Message: Django Shop settings

# Message: Database

# Message: Postgres

# Field:
# - Description:   Name of the database
# - Type:         string
# - Regex:        ^[a-zA-Z0-9_]*$
# - Props:        Required, Generate, Hidden
DB_NAME=localhost

# Field:
# - Description:   Name of the database user
DB_USER=

# Field:
# - Description:   Password of the database user
DB_PASSWORD=

# Field:
# - Description:   Host of the database
DB_HOST=

# Message: Email

# Message: SMTP

# Field:
# - Description:   Host of the email server
EMAIL_HOST=
